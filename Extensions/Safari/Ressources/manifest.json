{
  "manifest_version": 3,
  "name": "VibeSearch",
  "description": "Ouvre les pages et les liens dans VibeSearch.",
  "version": "1.0",
  "icons": { "48": "icone-48.png", "96": "icone-96.png", "128": "icone-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icone-48.png", "96": "icone-96.png" }
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contenu.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
