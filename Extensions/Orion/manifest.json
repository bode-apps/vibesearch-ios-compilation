{
  "manifest_version": 2,
  "name": "VibeSearch Passerelle",
  "description": "Avec Orion comme navigateur par défaut, chaque lien s'ouvre directement dans VibeSearch.",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "passerelle@vibesearch.bode-apps" } },
  "icons": { "48": "icone-48.png", "96": "icone-96.png", "128": "icone-128.png" },
  "browser_action": { "default_popup": "popup.html", "default_icon": { "48": "icone-48.png", "96": "icone-96.png" } },
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["passerelle.js"], "run_at": "document_start", "all_frames": false }
  ]
}